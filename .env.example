# MTLC MUN IV - Environment Variables Configuration

# Base application URL for SEO metadata & OpenGraph (e.g., https://mtlcmun.com or your deployment domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secretariat Admin Conclave access password
ADMIN_PASSWORD=MTLCMUN2026(1)

# Admin Session secret token (used for signing secure HTTP-only cookies)
ADMIN_SESSION_SECRET=mtlc_legacy_authenticated_session_secret_2026

# ==============================================================================
# TiDB Cloud Serverless Database (Recommended for Git / Vercel Deployments)
# 1. Create a free Serverless cluster at https://tidbcloud.com
# 2. In TiDB Cloud, click "Connect" -> select "General" / "Serverless Driver"
# 3. Paste the URL into TIDB_DATABASE_URL (or DATABASE_URL)
# Tables (mtlc_delegates, mtlc_settings) are automatically migrated on first run!
# ==============================================================================
TIDB_DATABASE_URL=
DATABASE_URL=

# Alternatively, you can specify individual TiDB connection parameters:
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=test

# ==============================================================================
# Upstash Redis / Vercel KV Alternative Cloud Storage
# In Vercel: Add Upstash Redis in the "Storage" tab with 1-click
# ==============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
